# Copy to .env for local dev. Never commit .env. Secrets are read from the
# environment only — never from Dagster run config or tags (ARCHITECTURE.md §5).
#
# This file has two halves:
#   1. OHDP_* — application config for local dev (uv run, dbt, dagster dev).
#   2. DEPLOY SECRETS — consumed by `act` as the GitHub Actions secrets store
#      (.actrc sets --secret-file .env). On real GitHub these are repo secrets;
#      the names below match `secrets.<NAME>` in .github/workflows/ exactly.
#
# You only need half 2 filled in to run the deploy workflows locally.

# ===========================================================================
# 1. APPLICATION CONFIG
# ===========================================================================

OHDP_ENVIRONMENT=local
OHDP_LOG_JSON=false
OHDP_LOG_LEVEL=INFO

# --- Object storage (DigitalOcean Spaces, S3-compatible) ---
# Postgres backups and Dagster's compute logs; only the lakehouse's table files
# are on AWS S3 (ADR-0019).
OHDP_SPACES_ENDPOINT_URL=https://nyc3.digitaloceanspaces.com
OHDP_SPACES_REGION=nyc3
OHDP_SPACES_ACCESS_KEY_ID=
OHDP_SPACES_SECRET_ACCESS_KEY=
OHDP_SPACES_BUCKET=ohdp-warehouse

# --- The Iceberg lakehouse (ADR-0019) ---
# Snowflake is the *catalog* only: dlt and dbt write Iceberg tables through
# Horizon's Iceberg REST endpoint, and Cube and Streamlit read the same tables
# over SQL. The files themselves stay in our own S3 bucket, reached through an
# external volume — Snowflake never stores them. Required for dlt raw loads and for dbt build/test —
# there is no offline target.
#
# Two credentials, because the two protocols differ:
#   OHDP_SNOWFLAKE_PAT          <- snowflake_pipeline_pat   (REST catalog; secret)
#   OHDP_SNOWFLAKE_PRIVATE_KEY  <- snowflake_private_key    (SQL; PKCS#8 PEM, secret)
#
# The rest, all from `terraform output` in platform/terraform:
#   OHDP_SNOWFLAKE_ACCOUNT      <- snowflake_account   (also the REST endpoint's host)
#   OHDP_SNOWFLAKE_USER         <- snowflake_user      (also the OAuth2 client id)
#   OHDP_SNOWFLAKE_ROLE         <- snowflake_role      (also the OAuth2 scope's role)
#   OHDP_SNOWFLAKE_WAREHOUSE    <- snowflake_warehouse
#   OHDP_AWS_REGION             <- aws_region
#   OHDP_LAKEHOUSE_BUCKET       <- lakehouse_bucket
#   OHDP_AWS_ACCESS_KEY_ID      <- aws_pipeline_access_key_id
#   OHDP_AWS_SECRET_ACCESS_KEY  <- aws_pipeline_secret_access_key  (secret)
#
# No catalog endpoint or namespace names: the endpoint is derived from the
# account (ohdp_shared.settings.horizon_catalog_uri) and the namespaces per
# medallion layer by ohdp_ingestion.naming and dbt's generate_schema_name.sql.
# No OHDP_SNOWFLAKE_DATABASE either: the catalog is ohdp_ingestion.naming.CATALOG.
OHDP_SNOWFLAKE_ACCOUNT=
OHDP_SNOWFLAKE_USER=OHDP_PIPELINE
OHDP_SNOWFLAKE_ROLE=OHDP_PIPELINE
OHDP_SNOWFLAKE_WAREHOUSE=OHDP_WH
OHDP_SNOWFLAKE_PAT=
OHDP_SNOWFLAKE_PRIVATE_KEY=
# The AWS half is for one job only: dlt writes each raw table's Parquet into
# the external volume's bucket itself and can't use the credentials Horizon
# vends. DuckDB does use those and needs no key.
OHDP_AWS_REGION=us-east-1
OHDP_LAKEHOUSE_BUCKET=ohdp-lakehouse
OHDP_AWS_ACCESS_KEY_ID=
OHDP_AWS_SECRET_ACCESS_KEY=

# --- Postgres (single instance, 4 logical DBs) ---
OHDP_POSTGRES_HOST=localhost
OHDP_POSTGRES_PORT=5432
OHDP_APP_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/app

# --- Ingestion source credentials ---
OHDP_OPENAQ_API_KEY=
# Socrata app tokens are optional — they only raise the rate limit; both
# healthdata.gov and data.cdc.gov are readable anonymously (ADR-0018).
OHDP_HEALTHDATA_APP_TOKEN=
OHDP_CDC_APP_TOKEN=

# --- Semantic layer / catalog ---
OHDP_CUBE_API_URL=http://localhost:4000
OHDP_CUBE_API_SECRET=

# --- Cube MCP server (ohdp_mcp, ADR-0017) ---
# The bearer token the MCP server requires of its caller. In-cluster both sides
# read it from the generated `mcp-cube-secret`. Locally, either set one here or
# set OHDP_MCP_ALLOW_ANONYMOUS=true — the server refuses to start with neither,
# because an unauthenticated default is what reaches production by accident.
#   uv run --project apps/api uvicorn ohdp_mcp.server:create_app --factory --port 8001
OHDP_MCP_AUTH_TOKEN=
OHDP_MCP_ALLOW_ANONYMOUS=
# The Cube tier every MCP query is run as — what cube.js `queryRewrite` reads to
# apply the row ceiling. Never taken from the caller.
OHDP_MCP_TIER=free
OHDP_OPENMETADATA_URL=http://localhost:8585
OHDP_OPENMETADATA_JWT=
# GraphQL endpoint OpenMetadata's Dagster connector reads from. In-cluster
# this is graphql-authz-proxy, not dagster-webserver directly (§5) — see
# ohdp_shared.settings.dagster_graphql_url.
OHDP_DAGSTER_GRAPHQL_URL=http://localhost:3000

# --- Chat quotas (provisional — §10.3) ---
OHDP_FREE_MONTHLY_QUESTIONS=20
OHDP_PAID_MONTHLY_QUESTIONS=500

# ===========================================================================
# 2. DEPLOY SECRETS  (act reads these as `secrets.*`; see docs/deploying.md)
# ===========================================================================

# --- Cluster access -------------------------------------------------------
# base64 of the kubeconfig, with 127.0.0.1 replaced by the node's public IP.
#   ssh root@<ip> 'cat /etc/rancher/k3s/k3s.yaml' | sed "s#127.0.0.1#<ip>#" | base64
# macOS: use `base64` (no -w); Linux: `base64 -w0`.
KUBECONFIG_B64=

# --- Terraform: DigitalOcean cluster + Cloudflare DNS + the AWS lakehouse --
DIGITALOCEAN_TOKEN=
# Admin AWS credentials Terraform itself uses (deploy-infra.yml passes them as
# TF_VAR_aws_*, NOT as AWS_ACCESS_KEY_ID — those belong to the Spaces state
# backend, which is also "S3"). Distinct from the pipeline IAM user below,
# which Terraform creates.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Second-apply inputs for the external volume's trust policy — leave blank
# until the volume exists; see platform/terraform/README.md.
SNOWFLAKE_STORAGE_AWS_IAM_USER_ARN=
SNOWFLAKE_STORAGE_AWS_EXTERNAL_ID=
# Cloudflare API token with DNS:Edit on the open-health-data-platform.org zone, plus its zone ID.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# Public IP of the Traefik load balancer. Leave blank until deploy-platform has
# run once — the *.open-health-data-platform.org A records are skipped until it is set:
#   kubectl -n infra get svc traefik -o jsonpath='{.status.loadBalancer.ingress[0].ip}'
LOADBALANCER_IP=

# --- DigitalOcean Spaces (S3-compatible; used for tfstate AND snapshots) --
# Generate under DO console -> API -> Spaces Keys. One key pair; the same two
# secret names are read by deploy-infra.yml (tfstate backend) and
# deploy-platform.yml (pipeline object storage). backend.tf pins the bucket +
# endpoint, so no *_ENDPOINT_URL secret is needed.
SPACES_ACCESS_KEY_ID=
SPACES_ACCESS_KEY=

# --- External secrets injected by deploy-platform.yml (`secrets` step) -----
# platform-base generates every INTERNAL secret (Postgres passwords, OM fernet
# key, Cube secret) inside the cluster. Only these externally-issued ones are
# passed in as repo secrets:
#   SPACES_ACCESS_KEY_ID / SPACES_ACCESS_KEY   (object storage, see above)
#   SNOWFLAKE_PIPELINE_PAT                     (the Iceberg catalog, ADR-0019)
#   AWS_PIPELINE_ACCESS_KEY_ID / _SECRET_ACCESS_KEY  (the volume's bucket)
#   OPENAQ_API_KEY, CDC_APP_TOKEN              (ingestion sources)
#   OPENMETADATA_JWT   -> ohdp-pipeline-secrets + hub-api-secrets
#   STRIPE_SECRET_KEY, OIDC_CLIENT_SECRET      (hub-api, M2/M4)
#   ANTHROPIC_API_KEY                          (the chat agent — hub-api only)
#   OPENROUTER_API_KEY                         (Open WebUI's model backend,
#                                               ADR-0023 — its OPENAI_API_KEY)
#   OPENWEBUI_OIDC_CLIENT_ID / _SECRET         (Open WebUI's Google SSO, ADR-0017)
# OPENMETADATA_JWT is minted BY OpenMetadata on first boot — set it after the
# first openmetadata deploy, then re-run the `secrets` component.
# The lakehouse credentials Terraform issues:
#   terraform output -raw snowflake_pipeline_pat         | gh secret set SNOWFLAKE_PIPELINE_PAT
#   terraform output -raw aws_pipeline_access_key_id     | gh secret set AWS_PIPELINE_ACCESS_KEY_ID
#   terraform output -raw aws_pipeline_secret_access_key | gh secret set AWS_PIPELINE_SECRET_ACCESS_KEY
SNOWFLAKE_PIPELINE_PAT=
AWS_PIPELINE_ACCESS_KEY_ID=
AWS_PIPELINE_SECRET_ACCESS_KEY=
OPENAQ_API_KEY=
CDC_APP_TOKEN=
OPENMETADATA_JWT=
STRIPE_SECRET_KEY=
OIDC_CLIENT_SECRET=
# hub-api's chat agent's Claude key (docs/chatbot.md). Lands in hub-api-secrets
# as OHDP_ANTHROPIC_API_KEY. Without it the app deploys and serves, and
# /api/chat answers 503 — every question costs real money, so this is the one
# secret whose absence is a safe default. Since ADR-0023 this key is hub-api's
# alone; Open WebUI bills OPENROUTER_API_KEY below.
ANTHROPIC_API_KEY=
# Open WebUI's model backend (ADR-0023): an OpenRouter key, sk-or-v1-...,
# landing in openwebui-secrets under the name OPENAI_API_KEY because OpenRouter
# is OpenAI-compatible. Give it a credit limit at
# https://openrouter.ai/settings/keys — it is reachable by every promoted chat
# user, and the per-user cap on top of it (ADR-0022) only works once the
# token-tracking pipe is registered by hand.
OPENROUTER_API_KEY=
# Open WebUI's own Google OAuth client (ADR-0017) — NOT one of the oauth2-proxy
# walls. Redirect URI:
#   https://chat.open-health-data-platform.org/oauth/google/callback
# Both fall back to the DAGSTER_OIDC_* client in deploy-platform.yml, which then
# needs that redirect URI added in the Google console.
OPENWEBUI_OIDC_CLIENT_ID=
OPENWEBUI_OIDC_CLIENT_SECRET=

# --- GHCR (act only; real GitHub injects this automatically) --------------
# A classic PAT with write:packages. Only needed to run `build-images` locally
# with push enabled — otherwise run it with --input push=false.
GITHUB_TOKEN=
