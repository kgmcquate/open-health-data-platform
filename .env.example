# Copy to .env for local dev. Never commit .env. Secrets are read from the
# environment only — never from Dagster run config or tags (ARCHITECTURE.md §5).
#
# This file has two halves:
#   1. OHDP_* — application config for local dev (uv run, dbt, dagster dev).
#   2. DEPLOY SECRETS — consumed by `act` as the GitHub Actions secrets store
#      (.actrc sets --secret-file .env). On real GitHub these are repo secrets;
#      the names below match `secrets.<NAME>` in .github/workflows/ exactly.
#
# You only need half 2 filled in to run the deploy workflows locally.

# ===========================================================================
# 1. APPLICATION CONFIG
# ===========================================================================

OHDP_ENVIRONMENT=local
OHDP_LOG_JSON=false
OHDP_LOG_LEVEL=INFO

# --- Object storage (Cloudflare R2, S3-compatible) ---
OHDP_R2_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
OHDP_R2_ACCESS_KEY_ID=
OHDP_R2_SECRET_ACCESS_KEY=
OHDP_R2_BUCKET=ohdp-warehouse
OHDP_SNAPSHOT_RETENTION=14

# --- Local warehouse (writer side only) ---
OHDP_DUCKDB_PATH=data/warehouse/warehouse.duckdb

# --- Postgres (single instance, 4 logical DBs) ---
OHDP_POSTGRES_HOST=localhost
OHDP_POSTGRES_PORT=5432
OHDP_APP_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/app

# --- Ingestion source credentials ---
OHDP_OPENAQ_API_KEY=
OHDP_CDC_APP_TOKEN=

# --- Semantic layer / catalog ---
OHDP_CUBE_API_URL=http://localhost:4000
OHDP_CUBE_API_SECRET=
OHDP_OPENMETADATA_URL=http://localhost:8585
OHDP_OPENMETADATA_JWT=

# --- Chat quotas (provisional — §10.3) ---
OHDP_FREE_MONTHLY_QUESTIONS=20
OHDP_PAID_MONTHLY_QUESTIONS=500

# ===========================================================================
# 2. DEPLOY SECRETS  (act reads these as `secrets.*`; see docs/deploying.md)
# ===========================================================================

# --- Cluster access -------------------------------------------------------
# base64 of the kubeconfig, with 127.0.0.1 replaced by the node's public IP.
#   ssh root@<ip> 'cat /etc/rancher/k3s/k3s.yaml' | sed "s#127.0.0.1#<ip>#" | base64
# macOS: use `base64` (no -w); Linux: `base64 -w0`.
KUBECONFIG_B64=

# --- Terraform: Kamatera + Cloudflare ------------------------------------
KAMATERA_API_CLIENT_ID=
KAMATERA_API_SECRET=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
DOMAIN=example.com
SSH_PUBLIC_KEY=ssh-ed25519 AAAA... you@example.com
# JSON list, exactly as Terraform expects a list(string). Never 0.0.0.0/0.
ADMIN_IP_RANGES=["203.0.113.4/32"]
ACME_EMAIL=you@example.com

# --- Terraform state backend (R2, S3-compatible) --------------------------
# Create the bucket by hand once — Terraform does not manage its own state
# bucket. See platform/terraform/backend.tf.
TFSTATE_BUCKET=ohdp-tfstate
R2_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Postgres: one instance, four databases (ARCHITECTURE.md §2) ----------
POSTGRES_PASSWORD=
DAGSTER_POSTGRES_PASSWORD=
SUPERSET_POSTGRES_PASSWORD=
OPENMETADATA_POSTGRES_PASSWORD=
APP_POSTGRES_PASSWORD=

# --- OpenMetadata ---------------------------------------------------------
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OPENMETADATA_FERNET_KEY=
OPENMETADATA_JWT=

# --- Application ----------------------------------------------------------
CUBE_API_SECRET=
STRIPE_SECRET_KEY=
OIDC_CLIENT_SECRET=

# --- Ingestion source credentials (same values as half 1) -----------------
OPENAQ_API_KEY=
CDC_APP_TOKEN=

# --- GHCR (act only; real GitHub injects this automatically) --------------
# A classic PAT with write:packages. Only needed to run `build-images` locally
# with push enabled — otherwise run it with --input push=false.
GITHUB_TOKEN=
