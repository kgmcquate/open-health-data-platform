# Copy to .env for local dev. Never commit .env. Secrets are read from the
# environment only — never from Dagster run config or tags (ARCHITECTURE.md §5).
#
# This file has two halves:
#   1. OHDP_* — application config for local dev (uv run, dbt, dagster dev).
#   2. DEPLOY SECRETS — consumed by `act` as the GitHub Actions secrets store
#      (.actrc sets --secret-file .env). On real GitHub these are repo secrets;
#      the names below match `secrets.<NAME>` in .github/workflows/ exactly.
#
# You only need half 2 filled in to run the deploy workflows locally.

# ===========================================================================
# 1. APPLICATION CONFIG
# ===========================================================================

OHDP_ENVIRONMENT=local
OHDP_LOG_JSON=false
OHDP_LOG_LEVEL=INFO

# --- Object storage (DigitalOcean Spaces, S3-compatible) ---
OHDP_SPACES_ENDPOINT_URL=https://nyc3.digitaloceanspaces.com
OHDP_SPACES_REGION=nyc3
OHDP_SPACES_ACCESS_KEY_ID=
OHDP_SPACES_SECRET_ACCESS_KEY=
OHDP_SPACES_BUCKET=ohdp-warehouse

# --- Snowflake data warehouse (ADR-0012/0013/0014) ---
# Required for both dlt raw loads and dbt build/test — there is no offline
# fallback (ADR-0014). These come from `terraform output` in
# platform/terraform:
#   OHDP_SNOWFLAKE_ACCOUNT      <- snowflake_account
#   OHDP_SNOWFLAKE_USER         <- snowflake_user
#   OHDP_SNOWFLAKE_PRIVATE_KEY  <- snowflake_private_key  (PKCS#8 PEM, secret;
#                                  SERVICE users don't accept password auth)
#   OHDP_SNOWFLAKE_ROLE         <- snowflake_role
#   OHDP_SNOWFLAKE_WAREHOUSE    <- snowflake_warehouse
# No OHDP_SNOWFLAKE_DATABASE: database names are fixed per medallion layer
# (RAW/CLEAN/CURATED, ohdp_ingestion.naming, ADR-0013), not configured here.
OHDP_SNOWFLAKE_ACCOUNT=
OHDP_SNOWFLAKE_USER=OHDP_PIPELINE
OHDP_SNOWFLAKE_PRIVATE_KEY=
OHDP_SNOWFLAKE_ROLE=OHDP_PIPELINE
OHDP_SNOWFLAKE_WAREHOUSE=OHDP_WH

# --- Postgres (single instance, 4 logical DBs) ---
OHDP_POSTGRES_HOST=localhost
OHDP_POSTGRES_PORT=5432
OHDP_APP_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/app

# --- Ingestion source credentials ---
OHDP_OPENAQ_API_KEY=
OHDP_CDC_APP_TOKEN=

# --- Semantic layer / catalog ---
OHDP_CUBE_API_URL=http://localhost:4000
OHDP_CUBE_API_SECRET=
OHDP_OPENMETADATA_URL=http://localhost:8585
OHDP_OPENMETADATA_JWT=

# --- Chat quotas (provisional — §10.3) ---
OHDP_FREE_MONTHLY_QUESTIONS=20
OHDP_PAID_MONTHLY_QUESTIONS=500

# ===========================================================================
# 2. DEPLOY SECRETS  (act reads these as `secrets.*`; see docs/deploying.md)
# ===========================================================================

# --- Cluster access -------------------------------------------------------
# base64 of the kubeconfig, with 127.0.0.1 replaced by the node's public IP.
#   ssh root@<ip> 'cat /etc/rancher/k3s/k3s.yaml' | sed "s#127.0.0.1#<ip>#" | base64
# macOS: use `base64` (no -w); Linux: `base64 -w0`.
KUBECONFIG_B64=

# --- Terraform: DigitalOcean cluster + Cloudflare DNS ---------------------
DIGITALOCEAN_TOKEN=
# Cloudflare API token with DNS:Edit on the open-health-data-platform.org zone, plus its zone ID.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# Public IP of the Traefik load balancer. Leave blank until deploy-platform has
# run once — the *.open-health-data-platform.org A records are skipped until it is set:
#   kubectl -n infra get svc traefik -o jsonpath='{.status.loadBalancer.ingress[0].ip}'
LOADBALANCER_IP=

# --- DigitalOcean Spaces (S3-compatible; used for tfstate AND snapshots) --
# Generate under DO console -> API -> Spaces Keys. One key pair; the same two
# secret names are read by deploy-infra.yml (tfstate backend) and
# deploy-platform.yml (pipeline object storage). backend.tf pins the bucket +
# endpoint, so no *_ENDPOINT_URL secret is needed.
SPACES_ACCESS_KEY_ID=
SPACES_ACCESS_KEY=

# --- External secrets injected by deploy-platform.yml (`secrets` step) -----
# platform-base generates every INTERNAL secret (Postgres passwords, OM fernet
# key, Cube secret) inside the cluster. Only these externally-issued ones are
# passed in as repo secrets:
#   SPACES_ACCESS_KEY_ID / SPACES_ACCESS_KEY   (object storage, see above)
#   OPENAQ_API_KEY, CDC_APP_TOKEN              (ingestion sources)
#   OPENMETADATA_JWT   -> ohdp-pipeline-secrets + hub-api-secrets
#   STRIPE_SECRET_KEY, OIDC_CLIENT_SECRET      (hub-api, M2/M4)
# OPENMETADATA_JWT is minted BY OpenMetadata on first boot — set it after the
# first openmetadata deploy, then re-run the `secrets` component.
OPENAQ_API_KEY=
CDC_APP_TOKEN=
OPENMETADATA_JWT=
STRIPE_SECRET_KEY=
OIDC_CLIENT_SECRET=

# --- GHCR (act only; real GitHub injects this automatically) --------------
# A classic PAT with write:packages. Only needed to run `build-images` locally
# with push enabled — otherwise run it with --input push=false.
GITHUB_TOKEN=
