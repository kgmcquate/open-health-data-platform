# Copy to terraform.tfvars (gitignored) and fill in.
# Tokens can also come from env: TF_VAR_hcloud_token, TF_VAR_cloudflare_api_token.

hcloud_token         = ""
cloudflare_api_token = ""
cloudflare_account_id = ""
cloudflare_zone_id   = ""

domain = "example.com"
name   = "ohdp"

# fsn1/nbg1 = Germany, hel1 = Finland, ash/hil = US. See ARCHITECTURE.md §10.1.
location    = "fsn1"
server_type = "cx52"

ssh_public_key = "ssh-ed25519 AAAA... you@example.com"

# Your admin networks. Never 0.0.0.0/0 — this gates the Kubernetes API.
admin_ip_ranges = ["203.0.113.4/32"]

# Pin k3s so an unattended reinstall cannot jump minor versions.
k3s_version = "v1.31.5+k3s1"

snapshot_bucket = "ohdp-warehouse"
