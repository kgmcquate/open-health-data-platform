# Copy to terraform.tfvars (gitignored) and fill in.
# The Cloudflare API token is NOT set here — export it as CLOUDFLARE_API_TOKEN
# in the environment (the cloudflare provider reads it directly).

name        = "ohdp"
location    = "nyc3"
server_type = "s-4vcpu-8gb"
node_count  = 1

snapshot_bucket = "ohdp-warehouse"

# Cloudflare DNS for the platform hostnames (token via CLOUDFLARE_API_TOKEN env).
cloudflare_zone_id = ""

# Left-most labels created as A records under dns_base.
dns_base      = "ohdp.kevinmcquate.com"
dns_hostnames = ["app", "dagster", "catalog", "cube", "superset"]

# Public IPv4 of the Traefik ingress. Set this explicitly here (or in the
# environment as TF_VAR_loadbalancer_ip) to the address Cloudflare should point
# to; do not create a DigitalOcean reserved IP for this.
loadbalancer_ip = ""
