# Copy to terraform.tfvars (gitignored) and fill in.
# Credentials can also come from env: KAMATERA_API_CLIENT_ID / KAMATERA_API_SECRET
# for the provider, and TF_VAR_cloudflare_api_token etc. for the rest.

kamatera_api_client_id = ""
kamatera_api_secret    = ""

cloudflare_api_token  = ""
cloudflare_account_id = ""
cloudflare_zone_id    = ""

domain = "example.com"
name   = "ohdp"

# Kamatera datacenter, matched by name via the kamatera_datacenter data source.
datacenter_country = "United States"
datacenter_name    = "New York"
image_code         = "24.04 64bit"

# CPU class A/B/D/T; 8 cores / 32 GB / 300 GB is the ARCHITECTURE.md §4 budget.
cpu_type      = "B"
cpu_cores     = 8
ram_mb        = 32768
disk_size_gb  = 300
billing_cycle = "monthly"

ssh_public_key = "ssh-ed25519 AAAA... you@example.com"

# Your admin networks. Never 0.0.0.0/0 — this gates SSH and the Kubernetes API.
admin_ip_ranges = ["203.0.113.4/32"]

# Pin k3s so an unattended reinstall cannot jump minor versions.
k3s_version = "v1.31.5+k3s1"

snapshot_bucket = "ohdp-warehouse"
