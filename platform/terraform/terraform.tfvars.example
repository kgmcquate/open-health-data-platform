# Copy to terraform.tfvars (gitignored) and fill in.
# The Cloudflare API token is NOT set here — export it as CLOUDFLARE_API_TOKEN
# in the environment (the cloudflare provider reads it directly).

name        = "ohdp"
location    = "nyc3"
server_type = "s-4vcpu-8gb"
node_count  = 1

snapshot_bucket = "ohdp-warehouse"

# Cloudflare DNS for the platform hostnames (token via CLOUDFLARE_API_TOKEN env).
cloudflare_zone_id = ""

# Left-most labels created as A records under dns_base.
dns_base      = "open-health-data-platform.org"
dns_hostnames = ["app", "dagster", "catalog", "cube", "streamlit"]

# Public IPv4 of the Traefik ingress. Set this explicitly here (or in the
# environment as TF_VAR_loadbalancer_ip) to the address Cloudflare should point
# to; do not create a DigitalOcean reserved IP for this.
loadbalancer_ip = ""

# --- The Iceberg lakehouse: AWS S3 + Glue (ADR-0019) -----------------------
# AWS credentials are NOT set here. Export them instead — and note the
# TF_VAR_ prefix: the plain AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY pair belongs
# to the Spaces state backend, which is also "S3" (see versions.tf).
#
#   export TF_VAR_aws_access_key_id=... TF_VAR_aws_secret_access_key=...
#
# Everything below has a working default; override only if you mean to.
# aws_region        = "us-east-1"
# lakehouse_bucket  = "ohdp-lakehouse"
# lakehouse_catalog = "lakehouse"        # must equal ohdp_ingestion.naming.CATALOG
# lakehouse_sources = ["healthdata_gov", "cdc"]
# lakehouse_marts   = ["core", "respiratory", ...]
#
# Filled in on the SECOND apply, from DESC EXTERNAL VOLUME / DESC CATALOG
# INTEGRATION — see README.md. Empty on the first one.
# snowflake_storage_aws_iam_user_arn = ""
# snowflake_storage_aws_external_id  = ""
# snowflake_glue_aws_iam_user_arn    = ""
# snowflake_glue_aws_external_id     = ""

# --- Snowflake: the read side of the lakehouse (ADR-0019) ------------------
# Credentials are NOT set here. Export them instead, the same way the Cloudflare
# token works:
#
#   export SNOWFLAKE_USER=... SNOWFLAKE_ROLE=ACCOUNTADMIN
#   export SNOWFLAKE_PRIVATE_KEY="$(cat ~/.snowflake/tf_key.p8)"   # or SNOWFLAKE_PASSWORD
#
# Get the two identifiers with:
#   SELECT CURRENT_ORGANIZATION_NAME(), CURRENT_ACCOUNT_NAME();
snowflake_organization_name = ""
snowflake_account_name      = ""

# Everything below has a working default; override only if you mean to.
# snowflake_warehouse     = "OHDP_WH"
# snowflake_pipeline_role = "OHDP_PIPELINE"
# snowflake_pipeline_user = "OHDP_PIPELINE"
#
# Account-wide network policy. Defaults to 0.0.0.0/0 — narrow it only once the
# DOKS egress IPs are stable, or a node recycle will lock out the account.
# snowflake_allowed_ips = ["0.0.0.0/0"]
